# Copy this file to ".env" for local testing. NEVER put real keys in this example file.
NODE_ENV=development
PORT=3000

# Supabase -> Connect -> "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=member-photos

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your live site address (used for payment return links), e.g. https://kgc-silk.vercel.app
PUBLIC_BASE_URL=

# Online giving — add the ones you use (leave the others empty)
PAYSTACK_SECRET_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET_HASH=

CORS_ORIGIN=
